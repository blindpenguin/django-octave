"""URL configuration."""

from __future__ import annotations

from django.contrib import admin
from django.urls import path
from drf_spectacular.views import (
    SpectacularAPIView,
    SpectacularRedocView,
    SpectacularSwaggerView,
)
from rest_framework_simplejwt.views import TokenRefreshView

from apps.core.throttling import throttled
# --- django-octave frontend imports begin ---
from apps.users.auth_api import EmailTokenObtainPairView, UserListView
from apps.users.auth_api import RegisterView
# --- django-octave frontend imports end ---

urlpatterns = [
    path("admin/", admin.site.urls),
    path("api/auth/token/", EmailTokenObtainPairView.as_view(), name="token_obtain_pair"),
    path("api/auth/token/refresh/", throttled(TokenRefreshView), name="token_refresh"),
    path("api/auth/register/", RegisterView.as_view(), name="auth_register"),
    path("api/users/", UserListView.as_view(), name="user_list"),
    path("api/schema/", SpectacularAPIView.as_view(), name="schema"),
    path(
        "api/schema/swagger-ui/",
        SpectacularSwaggerView.as_view(url_name="schema"),
        name="swagger-ui",
    ),
    path(
        "api/schema/redoc/",
        SpectacularRedocView.as_view(url_name="schema"),
        name="redoc",
    ),
]
