"""Production settings."""

import os

from django.core.exceptions import ImproperlyConfigured

from config.settings.base import *  # noqa: F403

# Refuse to boot with the placeholder / a weak key (same threshold as `check --deploy`).
if SECRET_KEY.startswith("change-me") or len(SECRET_KEY) < 50:  # noqa: F405
    msg = (
        "DJANGO_SECRET_KEY is a placeholder or shorter than 50 characters. Generate one with: "
        'python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"'
    )
    raise ImproperlyConfigured(msg)

# Refuse to boot without an explicit host list (the base default is localhost only).
if not os.environ.get("DJANGO_ALLOWED_HOSTS", "").strip():
    msg = (
        "DJANGO_ALLOWED_HOSTS is not set. List the host names this site is served "
        "from, comma separated (for example: example.com,www.example.com)."
    )
    raise ImproperlyConfigured(msg)
if "*" in ALLOWED_HOSTS:  # noqa: F405
    msg = "DJANGO_ALLOWED_HOSTS must not contain '*'. List the host names explicitly."
    raise ImproperlyConfigured(msg)

# API docs are admin-only: log in at /admin/, then open /api/schema/swagger-ui/.
SPECTACULAR_SETTINGS = {  # noqa: F405
    **SPECTACULAR_SETTINGS,  # noqa: F405
    "SERVE_PERMISSIONS": ["rest_framework.permissions.IsAdminUser"],
    "SERVE_AUTHENTICATION": ["rest_framework.authentication.SessionAuthentication"],
}

DEBUG = False
SECURE_PROXY_SSL_HEADER = ("HTTP_X_FORWARDED_PROTO", "https")
SECURE_SSL_REDIRECT = True
SESSION_COOKIE_SECURE = True
CSRF_COOKIE_SECURE = True
SECURE_HSTS_SECONDS = 60 * 60 * 24 * 30
SECURE_HSTS_INCLUDE_SUBDOMAINS = True
SECURE_CONTENT_TYPE_NOSNIFF = True
X_FRAME_OPTIONS = "DENY"
