DJANGO_SETTINGS_MODULE=config.settings.local
# Generate: python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
# prod settings refuse to start with this placeholder.
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
# Production: replace with your real host names (prod settings refuse to start without it, and reject '*').
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL={{ db_url_example }}
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
{% if use_multitenancy %}
# Multitenancy: pass tenant UUID via X-Tenant-ID header
{% endif %}
