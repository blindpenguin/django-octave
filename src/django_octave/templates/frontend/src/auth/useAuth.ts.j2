import { apiJson } from '../api/client'
import { clearTokens, isAuthenticated, setTokens, setUserEmail } from './tokens'

type TokenPair = { access: string; refresh: string }

/** Login via email + password (octave User.USERNAME_FIELD is email). */
export async function login(email: string, password: string): Promise<void> {
  const data = await apiJson<TokenPair>('/api/auth/token/', {
    method: 'POST',
    body: JSON.stringify({ email, password }),
  })
  setTokens(data.access, data.refresh)
  setUserEmail(email)
}

export function logout(): void {
  clearTokens()
}

{% if include_register %}
export async function register(
  email: string,
  password: string,
  passwordConfirm: string,
): Promise<void> {
  await apiJson('/api/auth/register/', {
    method: 'POST',
    body: JSON.stringify({
      email,
      password,
      password_confirm: passwordConfirm,
    }),
  })
  await login(email, password)
}
{% endif %}

export { isAuthenticated, getUserEmail } from './tokens'
