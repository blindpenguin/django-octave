<script setup lang="ts">
import { onMounted, ref } from 'vue'
import { useRouter } from 'vue-router'

import { type CrudRecord, useCrudResource } from '../../composables/useCrudResource'

const router = useRouter()
const { list } = useCrudResource('{{ api_collection }}')

const rows = ref<CrudRecord[]>([])
const error = ref('')
const loading = ref(true)

{% raw %}
function primaryLabel(row: CrudRecord): string {
  const fromApi = row.label
  if (fromApi != null && String(fromApi).trim() !== '') {
    return String(fromApi)
  }
{% endraw %}
  const v = row['{{ primary_field }}']
{% raw %}
  if (v != null && String(v).trim() !== '') {
    return String(v)
  }
  return row.id != null ? `#${row.id}` : '—'
}

function secondaryText(row: CrudRecord): string {
  const parts: string[] = []
{% endraw %}
{% for f in secondary_fields %}
  {
    const v = row['{{ f.name }}']
    if (v != null && String(v).trim() !== '') {
      parts.push(String(v))
    }
  }
{% endfor %}
{% raw %}
  return parts.join(' · ')
}
{% endraw %}

onMounted(async () => {
  try {
    rows.value = await list()
  } catch (e) {
    error.value = e instanceof Error ? e.message : 'Failed to load'
  } finally {
    loading.value = false
  }
})

function openDetail(id: unknown) {
  void router.push({
    name: '{{ model_plural }}-detail',
    params: { id: String(id) },
  })
}
</script>

<template>
  <div>
    <div class="mb-4 flex items-center justify-between gap-4">
      <h1 class="text-2xl font-semibold text-highlighted">{{ model_name }}</h1>
      <UButton :to="{ name: '{{ model_plural }}-create' }">New</UButton>
    </div>
    <UAlert v-if="error" color="error" :title="error" class="mb-4" />
    <div v-if="loading" class="text-muted px-1 py-3">Loading…</div>
    <p
      v-else-if="!rows.length"
      class="text-muted px-1 py-6"
    >
      No {{ model_name }} yet. Use New to create one.
    </p>
    <div
      v-else
      class="overflow-hidden rounded-lg border border-default divide-y divide-default"
    >
      <button
        v-for="row in rows"
        :key="String(row.id)"
        type="button"
        class="flex w-full min-h-14 items-center gap-3 px-3 py-3 text-left
               hover:bg-elevated/50 active:bg-elevated transition-colors"
        @click="openDetail(row.id)"
      >
        <div class="min-w-0 flex-1">
          <div class="truncate font-medium text-highlighted">
            {% raw %}{{ primaryLabel(row) }}{% endraw %}
          </div>
          <div
            v-if="secondaryText(row)"
            class="truncate text-sm text-muted"
          >
            {% raw %}{{ secondaryText(row) }}{% endraw %}
          </div>
        </div>
        <UIcon
          name="i-lucide-chevron-right"
          class="size-5 shrink-0 text-dimmed"
        />
      </button>
    </div>
  </div>
</template>
