<script setup lang="ts">
import { computed, onMounted, ref } from 'vue'
import { useRoute, useRouter } from 'vue-router'

import { type CrudRecord, useCrudResource } from '../../composables/useCrudResource'

const route = useRoute()
const router = useRouter()
const { retrieve, remove } = useCrudResource('{{ api_collection }}')

const item = ref<CrudRecord | null>(null)
const error = ref('')
const loading = ref(true)
const deleting = ref(false)
const confirmOpen = ref(false)

const id = computed(() => String(route.params.id))

onMounted(async () => {
  try {
    item.value = await retrieve(id.value)
  } catch (e) {
    error.value = e instanceof Error ? e.message : 'Failed to load'
  } finally {
    loading.value = false
  }
})

async function onDelete() {
  deleting.value = true
  try {
    await remove(id.value)
    await router.push({ name: '{{ model_plural }}-list' })
  } catch (e) {
    error.value = e instanceof Error ? e.message : 'Delete failed'
    confirmOpen.value = false
  } finally {
    deleting.value = false
  }
}
</script>

<template>
  <div>
    <div class="mb-4 flex items-center justify-between gap-4">
      <h1 class="text-2xl font-semibold text-highlighted">{{ model_name }} Detail</h1>
      <div class="flex gap-2">
        <UButton
          variant="outline"
          :to="{ name: '{{ model_plural }}-edit', params: { id } }"
        >
          Edit
        </UButton>
        <UButton color="error" variant="soft" @click="confirmOpen = true">
          Delete
        </UButton>
      </div>
    </div>
    <UAlert v-if="error" color="error" :title="error" class="mb-4" />
    <UCard>
      <div v-if="loading" class="text-muted">Loading…</div>
      <dl v-else-if="item" class="grid gap-3 sm:grid-cols-2">
{% for f in fields %}
        <div>
          <dt class="text-sm text-muted">{{ f.label }}</dt>
          <dd class="font-medium">{% raw %}{{ item['{% endraw %}{{ f.name }}{% raw %}'] ?? '—' }}{% endraw %}</dd>
        </div>
{% endfor %}
      </dl>
    </UCard>

    <UModal v-model:open="confirmOpen">
      <template #content>
        <div class="p-4 space-y-4">
          <p>Delete this {{ model_name }}? This cannot be undone.</p>
          <div class="flex justify-end gap-2">
            <UButton variant="ghost" @click="confirmOpen = false">Cancel</UButton>
            <UButton color="error" :loading="deleting" @click="onDelete">Delete</UButton>
          </div>
        </div>
      </template>
    </UModal>
  </div>
</template>
